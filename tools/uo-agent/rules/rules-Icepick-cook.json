{
  // Icepick's rules while he cooks fish steaks to raise his Intelligence (COOKING.md). cook.py copies this file into
  // the client's Agent/rules-Icepick.json; mine.py and lumber.py put their own rules back at their start.
  // He stands at 1756,1408 on the tower's ground floor: the forge (1755,1410) and the bottom wooden chest
  // (1757,1407, z 6) with the 5000 raw fish steaks are within two tiles, so he never walks.
  "map": 0,
  // the user takes over (2026-11-14, every character; uo.py "the user taking a character over")
  "handOver": true,
  // the smithy corner only. The user's big pile of raw fish steaks on the floor at 1758,1408 is outside it on
  // purpose (the user, 2026-11-17: "I do NOT want you to accidentally cook that whole pile")
  "areas": [
    { "name": "tower smithy", "box": [1755, 1407, 1757, 1410], "z": [0, 25] }
  ],
  "pauseForPeople": false,
  // the two chests stacked on the steak chest aren't his
  "offLimits": ["0x4073C9D0", "0x40531814"],
  // raw fish steaks are never picked up off the floor or dropped onto (the raw pile). Cooked ones aren't listed: the
  // cooked steaks go onto the cooked pile on the forge (the user, 2026-11-17), and neverTouch blocks that too
  "neverTouch": ["0x097A"],
  // raw fish steaks, double-clicked in his pack and aimed at the forge
  "useFromBackpack": ["0x097A"],
  "mounts": ["0x00042FCB"],
  // full speed (the user, 2026-11-05)
  "pacing": { "gap": [1100, 1100], "burst": 1000, "break": [1100, 1100], "aim": [0, 0] }
}
